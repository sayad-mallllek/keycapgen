---
// Shared shell for every page: head, fonts, nav, footer and Astro's ClientRouter,
// which turns link clicks into same-document view transitions.
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props { title?: string; description?: string; page: string }
const { title, description = 'Custom keyboards and desk accessories, made to order. Design every key in 3D.', page } = Astro.props;
const fullTitle = title ? `${title} · keycapgen` : 'keycapgen · Custom keyboards and desk gear';

// Page content slides up and fades in; going back reverses the direction.
const pageAnim = {
  forwards: {
    old: { name: 'ks-page-out', duration: '160ms', easing: 'cubic-bezier(.4,0,1,1)', fillMode: 'both' },
    new: { name: 'ks-page-in', duration: '380ms', delay: '70ms', easing: 'cubic-bezier(.2,.75,.15,1)', fillMode: 'both' },
  },
  backwards: {
    old: { name: 'ks-page-out-back', duration: '160ms', easing: 'cubic-bezier(.4,0,1,1)', fillMode: 'both' },
    new: { name: 'ks-page-in-back', duration: '380ms', delay: '70ms', easing: 'cubic-bezier(.2,.75,.15,1)', fillMode: 'both' },
  },
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#60A5FA" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0A1020" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      // Theme: follow the system unless the visitor picked one (kg-theme in localStorage). Runs before first paint,
      // and re-applies on each client-side navigation because the router swaps <html>'s attributes.
      (() => {
        const apply = root => { let t = null; try { t = localStorage.getItem('kg-theme'); } catch (e) {}
          if (t === 'light' || t === 'dark') root.setAttribute('data-theme', t); else root.removeAttribute('data-theme'); };
        apply(document.documentElement);
        if (!window.__kgTheme) { window.__kgTheme = 1; document.addEventListener('astro:before-swap', e => apply(e.newDocument.documentElement)); }
      })();
    </script>
    <meta name="ks-base" content="/" data-ext="" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Poppins (UI) and Comfortaa (wordmark), then the fonts offered for keycap legends in the customizer -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Comfortaa:wght@400&family=Public+Sans:ital,wght@0,400;0,500;0,700;1,400&family=Barlow:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&family=Fraunces:wght@500;700&family=Press+Start+2P&family=Bebas+Neue&family=Caveat:wght@500;700&family=Rubik+Mono+One&display=swap" />
    <ClientRouter />
  </head>
  <body data-page={page}>
    <script is:inline>
      // Intro loader, first visit per session: binary digits shuffle, "unlock" to light blue, the wordmark appears
      // with a shimmer, then the overlay fades out. Click or press any key to skip. Skipped for reduced motion.
      (() => {
        try { if (sessionStorage.getItem('ks-intro')) return; sessionStorage.setItem('ks-intro', '1'); } catch (e) { return; }
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        const root = document.documentElement, el = document.createElement('div');
        el.className = 'intro'; el.setAttribute('aria-hidden', 'true');
        el.innerHTML = '<div class="intro-grid">' + '<span></span>'.repeat(49) + '</div><div class="intro-word wordmark">keycapgen</div><div class="intro-skip">Click to skip</div>';
        document.body.appendChild(el); root.classList.add('intro-lock');
        const cells = [...el.querySelectorAll('.intro-grid span')], grid = el.firstChild, word = el.children[1], timers = [];
        const roll = () => cells.forEach(c => { c.textContent = Math.random() < 0.5 ? '0' : '1'; });
        roll(); const iv = setInterval(roll, 100);
        const at = (ms, fn) => timers.push(setTimeout(fn, ms));
        at(2400, () => { clearInterval(iv); cells.forEach((c, i) => { c.style.transitionDelay = i * 50 + 'ms'; }); grid.classList.add('unlock'); });
        at(2400 + 49 * 50 + 300, () => { grid.classList.add('gone'); word.classList.add('show'); });
        at(6000, () => word.classList.add('shine'));
        const end = () => {
          timers.forEach(clearTimeout); clearInterval(iv); el.classList.add('out');
          setTimeout(() => { el.remove(); root.classList.remove('intro-lock'); }, 500);
          removeEventListener('keydown', end);
        };
        at(8500, end); el.addEventListener('click', end); addEventListener('keydown', end);
      })();
    </script>
    <header class="nav" transition:persist="site-nav" transition:name="site-nav">
      <div class="nav-in">
        <a href="/" class="brand wordmark" aria-label="keycapgen home">keycapgen</a>
        <nav class="nav-links" id="navLinks" aria-label="Main">
          <a href="/shop" data-nav="shop">Shop</a>
          <a href="/keyboards" data-nav="keyboards">Keyboards</a>
          <a href="/customize" data-nav="customize" class="btn primary lg">Customize in 3D</a>
        </nav>
        <button type="button" class="theme-btn" aria-label="Switch to dark mode" title="Switch theme">
          <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.35 15.35A9 9 0 0 1 8.65 3.65 9 9 0 1 0 20.35 15.35z"/></svg>
          <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
        </button>
        <a href="/cart" class="cart-btn" data-nav="cart" aria-label="Cart">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9.5" cy="19.5" r="1.4"/><circle cx="17.5" cy="19.5" r="1.4"/><path d="M2.5 3.5h2.6l2.3 10.6a1.6 1.6 0 0 0 1.6 1.3h8.1a1.6 1.6 0 0 0 1.5-1.1L21 7.2H6.1"/></svg>
          <span class="badge" id="cartCount" data-n="0">0</span>
        </a>
        <button type="button" class="nav-toggle" aria-controls="navLinks" aria-expanded="false" aria-label="Menu">
          <svg class="i-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
          <svg class="i-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
    </header>

    <main id="main" transition:animate={pageAnim}>
      <slot />
    </main>

    <footer class="foot" transition:name="site-foot">
      <div class="foot-in">
        <div>
          <a href="/" class="wordmark">keycapgen</a>
          <p class="foot-tag">Desk gear, built key by key.</p>
        </div>
        <div>
          <h3>Shop</h3>
          <ul class="foot-links"><li><a href="/shop">Accessories</a></li><li><a href="/keyboards">Keyboards</a></li><li><a href="/customize">Customizer</a></li><li><a href="/cart">Cart</a></li></ul>
        </div>
        <div>
          <h3>Studio</h3>
          <p>Every order is made to your design.</p>
          <p>Prototype storefront: prices and products are examples.</p>
        </div>
      </div>
    </footer>
    <div class="toast" id="toast" role="status" aria-live="polite" transition:persist="toast" hidden><span id="toastMsg"></span><a href="/cart" id="toastLink">View cart</a></div>

    <script>
      import '../scripts/site.js';
    </script>
  </body>
</html>
