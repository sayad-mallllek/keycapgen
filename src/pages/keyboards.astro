---
import Base from '../layouts/Base.astro';
import BoardCard from '../components/BoardCard.astro';
import CtaBanner from '../components/CtaBanner.astro';
import { MODELS } from '../data/keyboards.js';
---
<Base title="Keyboards" page="keyboards">
  <section class="page">
    <div class="wrap">
      <div class="page-head" data-reveal><h1>Choose a board to customize</h1><p class="lede">Pick a colorway, then open the board in the 3D customizer to change any key before adding it to your cart.</p></div>
      <div class="filters"><div class="chips" role="group" aria-label="Layout">
        {['all', '60%', '75%', 'TKL', '100%'].map(g => <button type="button" class="chip" data-kb={g} aria-pressed={g === 'all' ? 'true' : 'false'}>{g === 'all' ? 'All layouts' : g}</button>)}
      </div></div>
      <div class="grid cards" id="kbGrid">{Object.keys(MODELS).map((mid, i) => <BoardCard mid={mid} order={i} />)}</div>
      <p class="note" style="margin-top:40px;text-align:center">Product photos from each maker. The customizer uses simplified 3D models. keycapgen is not affiliated with the keyboard brands shown.</p>
    </div>
  </section>
  <CtaBanner title="Can't pick just one?" sub="Open any board in the customizer and try every layout, colorway and legend before you buy." />
</Base>
