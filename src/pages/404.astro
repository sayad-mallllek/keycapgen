---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" page="404">
  <section class="nf">
    <div class="nf-in">
      <h1>404</h1>
      <p>We couldn't find that page. It may have moved, or the link may be mistyped.</p>
      <a class="btn-utility" href="/">Go Back</a>
    </div>
  </section>
</Base>
