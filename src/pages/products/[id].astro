---
import Base from '../../layouts/Base.astro';
import { PRODUCTS, CATS } from '../../data/products.js';
import { artSVG } from '../../lib/svg.js';
import { money } from '../../lib/util.js';
export function getStaticPaths() {
  return PRODUCTS.map(p => ({ params: { id: p.id }, props: { p } }));
}
const { p } = Astro.props;
const cat = CATS.find(c => c.id === p.cat).name;
---
<Base title={p.name} description={p.blurb} page="product">
  <section class="page">
    <div class="wrap">
      <a class="back" href="/shop">← Back to shop</a>
      <div class="pd" data-product={p.id}>
        <div class="pd-media">
          <div class="pd-stage" id="pdStage" transition:name={`prod-${p.id}`} set:html={artSVG(p)} />
          <p class="note">Illustrated preview. Colors are shown as close as a screen allows.</p>
        </div>
        <div class="pd-info">
          <div class="card-cat">{cat}</div>
          <h1 transition:name={`prod-title-${p.id}`}>{p.name}</h1>
          <p class="lede">{p.blurb}</p>
          <div class="pd-price" id="pdPrice">{money(p.price)}</div>
          <div id="pdOpts"></div>
          <div class="buy-row">
            <div class="qty" aria-label="Quantity"><button type="button" data-q="-1" aria-label="Decrease quantity">−</button><span id="pdQty">1</span><button type="button" data-q="1" aria-label="Increase quantity">+</button></div>
            <button type="button" class="btn primary lg" id="pdAdd">Add to cart</button>
          </div>
          <dl class="specs">
            {p.specs.map(([a, b]) => <><dt>{a}</dt><dd>{b}</dd></>)}
            <dt>Made to order</dt><dd>Built to your configuration</dd>
          </dl>
        </div>
      </div>
    </div>
  </section>
</Base>
