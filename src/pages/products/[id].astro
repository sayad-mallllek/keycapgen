---
import Base from '../../layouts/Base.astro';
import { PRODUCTS, CATS, defaultsOf, variantOf } from '../../data/products.js';
import { artSVG } from '../../lib/svg.js';
import { photoHTML } from '../../lib/photo.js';
import { money } from '../../lib/util.js';
export function getStaticPaths() {
  return PRODUCTS.map(p => ({ params: { id: p.id }, props: { p } }));
}
const { p } = Astro.props;
const cat = CATS.find(c => c.id === p.cat).name;
const vc = variantOf(p, defaultsOf(p));
const main = photoHTML(vc.images[0], `${p.brand} ${p.name}, ${vc.v}`, artSVG(p), true);
---
<Base title={p.name} description={p.blurb} page="product">
  <section class="page">
    <div class="wrap">
      <a class="back" href="/shop">← Back to shop</a>
      <div class="pd" data-product={p.id}>
        <div class="pd-media">
          <div class="pd-stage" id="pdStage" transition:name={`prod-${p.id}`} set:html={main} />
          <div class="pd-thumbs" id="pdThumbs" role="group" aria-label="Photos"></div>
          <p class="note">Product photos from <a href={p.source} target="_blank" rel="noopener">{p.brand}</a>. Keycap Studio adds the options below and is not affiliated with {p.brand}.</p>
        </div>
        <div class="pd-info">
          <div class="card-cat">{cat} · {p.brand}</div>
          <h1 transition:name={`prod-title-${p.id}`}>{p.name}</h1>
          <p class="lede">{p.blurb}</p>
          <p class="pd-sig">{p.signature}</p>
          <div class="pd-price" id="pdPrice">{money(p.price)}</div>
          <div id="pdOpts"></div>
          <div class="buy-row">
            <div class="qty" aria-label="Quantity"><button type="button" data-q="-1" aria-label="Decrease quantity">−</button><span id="pdQty">1</span><button type="button" data-q="1" aria-label="Increase quantity">+</button></div>
            <button type="button" class="btn primary lg" id="pdAdd">Add to cart</button>
          </div>
          <dl class="specs">
            {p.specs.map(([a, b]) => <><dt>{a}</dt><dd>{b}</dd></>)}
            {p.options.some(o => o.type === 'toggle' || o.type === 'text') && <><dt>Add-ons</dt><dd>Applied by Keycap Studio before shipping</dd></>}
          </dl>
        </div>
      </div>
    </div>
  </section>
</Base>
